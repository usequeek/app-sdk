{
  "name": "@usequeek/app-sdk",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "description": "SDK for Queek installable apps: webhook signature verification, install handlers, typed Merchant API client, webhook dispatch, encrypted installation store.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usequeek/app-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "openapi/merchant.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "verify-package": "node scripts/verify-package.mjs",
    "gen:merchant": "node scripts/gen-merchant-types.mjs",
    "check:merchant-snapshot": "node scripts/check-merchant-snapshot.mjs",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "peerDependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "hono": "4.13.9",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  }
}
